{
  "name": "deal-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Retail clearance deal engine — daily sweep, markdown-stage detection, penny scoring, operator dashboard.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "migrate": "tsx src/db/migrate.ts",
    "scan": "tsx src/ingest/run-scan.ts",
    "scan:dry": "tsx src/ingest/run-scan.ts --dry",
    "replay": "tsx src/ingest/replay.ts",
    "probe:unwrangle": "tsx src/vendors/probe-unwrangle.ts",
    "probe:stock": "tsx src/vendors/probe-stock.ts",
    "probe:proxies": "tsx src/net/probe-proxies.ts",
    "score": "tsx src/engine/rebuild.ts",
    "alerts": "tsx src/alerts/run.ts",
    "dev": "concurrently -n api,web -c yellow,cyan \"tsx watch src/api/server.ts\" \"vite --config web/vite.config.ts\"",
    "start": "tsx src/api/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "fixtures": "tsx src/ingest/fixtures.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "purge": "tsx src/ingest/purge-fixtures.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tsx": "^4.19.2",
    "undici": "^7.29.0",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
