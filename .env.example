# Copy to .env and fill in. NEVER commit .env.
# Keep real keys out of the Obsidian vault too — it syncs to iCloud.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# "pglite"  — local file-backed Postgres, no install, no account. Dev only:
#             PGlite is alpha and gives no durability warranty.
# "postgres" — real Postgres (Neon). Switch to this the day the first real
#             Apify scan runs, because from then on the data is irreplaceable.
DB_DRIVER=pglite

# Used when DB_DRIVER=pglite
PGLITE_PATH=./.data/deal-engine

# Used when DB_DRIVER=postgres (Neon connection string)
DATABASE_URL=

# ---------------------------------------------------------------------------
# Operator
# ---------------------------------------------------------------------------
# Home location — distances on the dashboard are measured from here.
# San Antonio / Hollywood Park default.
HOME_LAT=29.6047
HOME_LNG=-98.4947

# Single operator until there are real users. Every query still takes this as
# a parameter so user scoping is never retrofitted.
OPERATOR_USER_ID=1

# ---------------------------------------------------------------------------
# Vendors (leave blank until you subscribe)
# ---------------------------------------------------------------------------
APIFY_TOKEN=
# Measured 2026-08-16: 17 monthly users, 98.7% success, 24-48h support,
# $0.85/1k results. The category is immature, so expect to swap this.
APIFY_ACTOR_ID=scrapyspider/home-depot-clearance-scraper
SCAN_ZIPS=78232,78216,78248,78258

KEEPA_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# API_PORT takes precedence over PORT, so a launcher that exports PORT
# (preview harnesses, IDE runners) cannot hand the API the web port.
API_PORT=8787
PORT=8787

# Local development only. Lets a signed-in user activate a plan WITHOUT paying,
# so the app is usable while Stripe is stubbed. The server refuses this unless
# NODE_ENV is not 'production' AND this is exactly 'true'. Never set in prod.
ALLOW_DEV_PLAN_ACTIVATION=false

# Store-level lookups (aisle/bay probe).
UNWRANGLE_KEY=

# Which metros the product actually works in. A new metro needs the scan
# running for WEEKS before scores mean anything, so this is deliberately
# separate from SCAN_ZIPS and changed on purpose.
COVERAGE_ZIP_PREFIXES=782,780,781
COVERAGE_METRO_NAME=San Antonio

# ISP proxies for calling Home Depot directly. Comma OR newline separated.
# Any of these per-proxy formats work:
#   host:port:user:pass      user:pass@host:port      http://user:pass@host:port
# Alternative: put one per line in proxies.txt (also gitignored).
PROXY_LIST=
